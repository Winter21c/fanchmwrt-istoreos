# ---------------------------------------------------------------------------
# fanchmwrt 原始 feed
# ----
# 上游 OpenWrt 的四个 feed 原本指向 git.openwrt.org。本机实测该域名
# 只有约 1 MB/min，因此改写为官方 GitHub 镜像（同一仓库、同一提交，内容一致）。
# 提交 pin 与原文件完全一致，未做任何改动。
# ----
# 注意：scripts/feeds 的解析器先做 s/#.+$// 再判空，所以本文件里不能出现
# 只有单个 "#" 的空注释行，否则会报 "Syntax error"。下面每行注释都带内容。
# ---------------------------------------------------------------------------
src-git packages https://github.com/openwrt/packages.git^f91b06b3faff7ad3c8cbeb1ab39cef680d2f28ed
src-git luci https://github.com/openwrt/luci.git^e9ebca7598ce2f754b76267fd66bf2b85e6e4347
src-git routing https://github.com/openwrt/routing.git^b2097c85bef85251364f59a6b2a3ed1f9f5c0c21
src-git telephony https://github.com/openwrt/telephony.git^2618106d5846a4a542fdf5809f0d3ed228ce439b
src-git video https://github.com/openwrt/video.git^094bf58da6682f895255a35a84349a79dab4bf95
src-git fanchmwrt https://github.com/fanchmwrt/fanchmwrt-packages.git

# ---------------------------------------------------------------------------
# iStoreOS 集成 feed
# ----
# 这些是 iStoreOS 官方使用的上游仓库，与 istoreos/istoreos 的
# feeds.conf.default 以及 linkease/openwrt-app-actions 的 feeds.conf 一致。
# ---------------------------------------------------------------------------
# iStore 应用商店：luci-app-store / taskd / luci-lib-taskd / luci-lib-xterm
src-git istore https://github.com/linkease/istore.git;main
# 首页面板后端（quickstart 预编译二进制）+ webdav2 + unishare
src-git nas https://github.com/linkease/nas-packages.git;master
# 首页面板前端：luci-app-quickstart、luci-app-unishare 等
src-git nas_luci https://github.com/linkease/nas-packages-luci.git;main
# mergerfs 与 luci-app-mergerfs
src-git istoreapps https://github.com/linkease/openwrt-apps.git;main
# luci-app-nfs（官方 luci 已移除该应用）
src-git third https://github.com/jjm2473/openwrt-third.git;main
# luci-app-diskman（磁盘管理）
src-git diskman https://github.com/lisaac/luci-app-diskman.git;master
# mosdns（DNS 转发器）+ luci-app-mosdns
# 官方 packages feed 早已移除 mosdns，这里用社区维护的 v5 分支
src-git mosdns https://github.com/sbwml/luci-app-mosdns.git;v5
