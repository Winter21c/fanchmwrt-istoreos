+	if [ -f "${DOCKERD_CONF}" -a -f /etc/config/dockerd ]; then
+		local oldroot=`jsonfilter -i "${DOCKERD_CONF}" -e @[\"data-root\"]`
+		local newroot=`uci get dockerd.globals.data_root`
